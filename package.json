{
  "name": "ai-command-center",
  "version": "0.1.0",
  "description": "Personal AI operating system — V1: Central Core + Memory + Tools + 3 agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node --import tsx --test --test-force-exit src/llm/classifier.cloud.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "allowScripts": {}
}
