{
  "name": "ai-command-center",
  "version": "0.1.0",
  "description": "Personal AI operating system — V1: Central Core + Memory + Tools + 3 agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node scripts/run-all-tests.mjs",
    "test:live": "node scripts/run-all-tests.mjs --live",
    "typecheck": "tsc --noEmit",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:start": "node node_modules/electron/cli.js dist-electron/electron/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "electron": "^45.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xyflow/react": "^12.3.0",
    "dagre": "^0.8.5",
    "framer-motion": "^11.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/dagre": "^0.7.0"
  },
  "allowScripts": {}
}
